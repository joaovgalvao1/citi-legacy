# Copie para .env.local e preencha. Sem chaves, o resumo usa o "resumo automático" (regras, sem IA).

# Gemini (principal) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# opcional; um ou vários modelos separados por vírgula, tentados em ordem.
# padrão: gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_MODEL=

# Groq (reserva) — https://console.groq.com/keys
GROQ_API_KEY=
# opcional; padrão: llama-3.3-70b-versatile
GROQ_MODEL=
