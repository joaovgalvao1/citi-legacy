# Banco de dados Postgres. Local: docker compose up -d (usa a URL abaixo).
# Na Vercel: a URL do Neon (Storage → Neon) é preenchida automaticamente.
DATABASE_URL=postgres://citi:citi@localhost:5433/citi_legacy

# Segredo que protege a rota do cron semanal (/api/cron/resumos). Na Vercel, defina CRON_SECRET.
CRON_SECRET=

# Copie para .env.local e preencha. Sem chaves, o resumo usa o "resumo automático" (regras, sem IA).

# Gemini (principal) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# opcional; um ou vários modelos separados por vírgula, tentados em ordem.
# padrão: gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.5-flash
GEMINI_MODEL=

# Groq (reserva) — https://console.groq.com/keys
GROQ_API_KEY=
# opcional; padrão: llama-3.3-70b-versatile
GROQ_MODEL=

# Boletim semanal por e-mail (Resend) — https://resend.com/api-keys
# Sem domínio próprio, o Resend só envia para o e-mail da sua conta.
RESEND_API_KEY=
# destinatários, separados por vírgula
BOLETIM_PARA=
# opcionais
BOLETIM_DE=
SITE_URL=

# GitHub (repositório dos projetos): token fine-grained somente leitura (Contents e Metadata: read-only).
# Sem ele, vale o limite público de 60 consultas/hora e só repositórios públicos.
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
# segredo do webhook do repositório (Settings → Webhooks; evento "push"; URL /api/github/webhook)
GITHUB_WEBHOOK_SECRET=
